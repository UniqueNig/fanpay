# Backend API — the Express server in ./server
VITE_API_URL=http://localhost:4000

# Canonical site URL, no trailing slash — used to build absolute canonical/
# Open Graph URLs (src/components/SEO.jsx). Update this once a custom domain
# is live; until then the Vercel URL is a reasonable default.
VITE_SITE_URL=https://fanpay-peach.vercel.app

# Paystack public key — get from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase — get from Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
