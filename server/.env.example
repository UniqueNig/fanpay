# Server
PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# MongoDB (must be a replica set — Atlas is one by default; see server/README.md for local dev)
MONGODB_URI=mongodb://localhost:27017/abopay?replicaSet=rs0

# Firebase Admin (verifies ID tokens, and also reads/writes Firestore for the AI live chat listener)
# Paste the full service account JSON as a single line, or point to a file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: path to the service account file instead of inlining JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx

# VTpass (being migrated off of — see MASKAWASUB_* below)
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Sandbox while testing; switch to https://vtpass.com/api for production
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# Maskawasub (new VTU provider) — get your token at https://www.maskawasub.com/documentation/
MASKAWASUB_API_KEY=
MASKAWASUB_BASE_URL=https://www.maskawasub.com/api

# Aspfiy (virtual account funding — Paga/Palmpay reserved accounts) — get your secret key from your Aspfiy dashboard
ASPFIY_SECRET_KEY=
ASPFIY_BASE_URL=https://api-v1.aspfiy.com
# Must be a real, internet-reachable URL once deployed — Aspfiy sends funding
# webhooks here. localhost is fine for now, but won't actually receive webhooks
# until this is deployed or tunneled (ngrok etc.) for local testing.
PUBLIC_API_URL=http://localhost:4000

# Claude (AI-powered support chat) — get your key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=
